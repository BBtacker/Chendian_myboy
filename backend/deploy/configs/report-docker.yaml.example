Name: report-service
ListenOn: 0.0.0.0:8084
Mode: dev

Etcd:
  Hosts:
    - etcd:2379
  Key: report.rpc

MySQL:
  DataSource: "root:your-mysql-password@tcp(mysql:3306)/face?charset=utf8mb4&parseTime=true&loc=Local"

Cache:
  Host: redis:6379
  Password: ""
  DB: 0

Log:
  Mode: console
  Level: info
